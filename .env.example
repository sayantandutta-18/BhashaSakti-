# BhashaSandhi Environment Configuration Example
# Copy this file to .env and fill in your real keys

# Google Gemini API key for Gemma 4 (Required for Gemma 4 prize)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model ID on Gemini API (default: gemma-4-26b-a4b-it, fallback: gemma-4-31b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Groq API key for high-speed Whisper-large-v3 cloud STT (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# STT Backend selection: "groq" | "local" | "auto" (default: "auto")
# If "auto", uses Groq when GROQ_API_KEY is present, else falls back to local faster-whisper or mock
STT_BACKEND=auto

# Local faster-whisper model size (tiny, base, small, medium)
WHISPER_LOCAL_MODEL=small

# SQLite database path for persistent conversation history
DB_PATH=data/team_j.db

# Server port and rate limit settings
PORT=8080
RATE_LIMIT_RPM=60
MAX_CONTENT_LENGTH=10485760
